# ==========================================
# FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# These are used by the Vue.js frontend

# API Configuration - Netlify Functions  
VITE_API_URL=/.netlify/functions

# Pusher Configuration (optional - for real-time updates)
VITE_PUSHER_APP_KEY=your_pusher_app_key_here
VITE_PUSHER_APP_CLUSTER=your_pusher_cluster_here

# ==========================================
# NETLIFY FUNCTIONS ENVIRONMENT VARIABLES
# ==========================================
# These must be set in Netlify Dashboard > Site Settings > Environment Variables
# DO NOT set these in .env file - they are for Netlify deployment only

# MongoDB Configuration
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/garden-for-all

# JWT Configuration  
# JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long
# JWT_EXPIRES_IN=7d

# Admin User Configuration
# ADMIN_EMAIL=admin@gardenforall.org
# ADMIN_PASSWORD=your-secure-admin-password

# Geocoding API Configuration (Mapbox)
# MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_access_token_here

# Email Service Configuration (Mailgun)
# MAILGUN_API_KEY=your_mailgun_api_key_here
# MAILGUN_DOMAIN=your_mailgun_domain_here
# FROM_EMAIL=noreply@gardenforall.org
# FROM_NAME=Garden For All
# MAILGUN_API_URL=https://api.mailgun.net

# Node Environment
# NODE_ENV=production