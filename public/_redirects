# API URL abstraction - rewrite /api/* to /.netlify/functions/*
# 200! (forced) so the SPA fallback / dev server can never shadow API routes
/api/*  /.netlify/functions/:splat  200!

# NOTE: The SPA catch-all (/* /index.html 200) must NOT live in this file.
# Vite copies public/_redirects into dist/, and `netlify dev` reads
# dist/_redirects — so a catch-all here gets applied in dev, where it rewrites
# 404'd module requests to /index.html and Vite fails parsing HTML as JS.
# Instead it is appended to dist/_redirects by the build command in netlify.toml,
# so it only exists in deployed builds.
